# Copia este archivo como .env.local (no se sube al repositorio) y completa los valores.
# URL del proyecto de Supabase (no es secreta)
VITE_SUPABASE_URL=https://<ref>.supabase.co
# Publishable key (sb_publishable_…) de Supabase › Project Settings › API Keys.
# Es pública por diseño: la seguridad la da RLS. Nunca pongas aquí la secret / service_role key.
VITE_SUPABASE_ANON_KEY=
